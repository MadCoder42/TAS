{
  "manifest_version": 3,
  "name": "TAS: Translate Any Subtitle",
  "short_name": "TAS",
  "version": "1.0.0",
  "description": "Finds the subtitles a video loads (YouTube timedtext and more), translates them block by block with Gemini and draws them on the video.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "TAS",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/shared.js", "lib/captions.js", "lib/vault.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["lib/shared.js", "lib/captions.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "TAS@example.local", "strict_min_version": "128.0" }
  }
}
